# LLM Provider Configuration
# Supported Options: groq | local_fallback | ministral
LLM_PROVIDER=groq

# Groq API Configuration (Free developer tier)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Supabase Server Configuration (Server-side privileged client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Application Server
HOST=0.0.0.0
PORT=8000
APP_ENV=development
